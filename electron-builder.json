{
  "appId": "com.alc.mediaplayer",
  "productName": "ALC Media Player",
  "directories": {
    "output": "dist-installer"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "win": {
    "target": "nsis"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "ALC Media Player"
  }
}
