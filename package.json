{
  "name": "alc-media-player",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop:portable": "npm run build && electron-packager . \"ALC Media Player\" --platform=win32 --arch=x64 --out=dist-app --overwrite --prune=true --no-asar --app-version=0.1.0 --ignore=\"release.*\" --ignore=\"dist-app.*\" --ignore=\"dist-desktop.*\" --ignore=\"dev\\.log\"",
    "desktop:dir": "npm run desktop:portable",
    "desktop:build": "npm run desktop:portable",
    "installer:build": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "hls.js": "^1.7.3",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "^26.18.0",
    "typescript": "latest",
    "wait-on": "latest"
  }
}
